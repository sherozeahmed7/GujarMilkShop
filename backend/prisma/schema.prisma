generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model for authentication and role-based access control
model User {
  id              Int      @id @default(autoincrement())
  name            String?  // Optional display name of the user
  email           String   @unique
  password        String   // Hashed password string using bcrypt
  role            String   @default("user") // User role (e.g. "admin", "cashier", "manager")
  status          String   @default("active") // Account status: "active" or "inactive"
  
  // We store assigned screen names as a JSON array string (e.g. '["POS", "Dashboard"]').
  assignedScreens String   @default("[]") 
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  openedShifts     Shift[]  @relation("ShiftOpenedBy")
  closedShifts     Shift[]  @relation("ShiftClosedBy")
}

// Cash drawer session for one shop day. Only one open shift is allowed at a time.
model Shift {
  id             Int      @id @default(autoincrement())
  shiftDate      String   @unique
  openedById     Int
  openedBy       User     @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedById     Int?
  closedBy       User?    @relation("ShiftClosedBy", fields: [closedById], references: [id])
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  openingCash    Float
  openingNotes   String?
  expectedCash   Float    @default(0)
  countedCash    Float?
  difference     Float?
  differenceStatus String?
  closingNotes   String?
  status         String   @default("Open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([openedAt])
}

// Temporary POS bills owned by the cashier who created them
model HeldCart {
  id        Int      @id @default(autoincrement())
  userId    Int
  snapshot  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// DailyRate model for tracking historical and current prices
model DailyRate {
  id            Int      @id @default(autoincrement())
  milkRate      Float
  yogurtRate    Float
  updatedByRole String   // Role of the user who made the update (e.g., "super_admin")
  date          DateTime // The effective date of the rate
  createdAt     DateTime @default(now())
}

// Registered ledger customers only (walk-in/split do NOT create a Customer row)
model Customer {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?
  address      String?
  customerType String   // "daily_ledger" | "monthly_ledger"
  status       String   @default("active") // "active" | "inactive"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]
}

// Master transaction record
model Sale {
  id               Int        @id @default(autoincrement())
  saleType         String     // "walk_in" | "split" | "ledger_daily" | "ledger_monthly"
  customerId       Int?       // NULL for walk-in/split; REQUIRED for ledger
  customer         Customer?  @relation(fields: [customerId], references: [id])
  customerName     String?    // optional — walk-in/split only
  customerPhone    String?    // optional — walk-in/split only
  totalAmount      Float
  paidAmount       Float
  remainingBalance Float      // totalAmount - paidAmount
  status           String     // "paid" | "partial" | "pending"
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  items            SaleItem[]
  payments         Payment[]
}

// Line items per sale (unitPrice locked at sale time)
model SaleItem {
  id         Int      @id @default(autoincrement())
  saleId     Int
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemName   String   // "milk" | "yogurt"
  quantity   Float    // weight in kg
  unitPrice  Float    // price per kg at time of sale
  totalPrice Float    // quantity × unitPrice
  createdAt  DateTime @default(now())
}

// Payment records per sale
model Payment {
  id        Int      @id @default(autoincrement())
  saleId    Int
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    String   // "cash" | "online"
  amount    Float
  status    String   // "completed" | "partial" | "pending"
  createdAt DateTime @default(now())
}

// Daily stock record for F2 milk products (Lassi, Butter, Ghee)
// One record per calendar date — enforced by unique constraint on date
model MilkProductDailyStock {
  id              Int      @id @default(autoincrement())
  date            DateTime @unique
  milkTotal       Float    @default(0)
  lassiProduced   Float    @default(0)
  lassiSold       Float    @default(0)
  lassiRemaining  Float    @default(0)
  butterOpening   Float    @default(0)
  butterProduced  Float    @default(0)
  butterSold      Float    @default(0)
  butterConverted Float    @default(0)
  butterClosing   Float    @default(0)
  gheeOpening     Float    @default(0)
  gheeProduced    Float    @default(0)
  gheeSold        Float    @default(0)
  gheeClosing     Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Transaction log for all F2 stock movements
model MilkProductTransaction {
  id        Int      @id @default(autoincrement())
  date      DateTime
  product   String   // "Milk" | "Lassi" | "Butter" | "Ghee"
  type      String   // "milk_added" | "lassi_produced" | "lassi_sold" | "butter_produced" | "butter_sold" | "butter_converted" | "ghee_produced" | "ghee_sold" | "opening" | "adjustment"
  quantity  Float
  reference String?
  notes     String?
  createdAt DateTime @default(now())
}

// Butter → Ghee conversion records
model ButterGheeConversion {
  id           Int      @id @default(autoincrement())
  date         DateTime
  butterUsed   Float
  gheeProduced Float
  notes        String?
  createdAt    DateTime @default(now())
}
