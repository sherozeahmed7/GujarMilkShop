{
  "name": "gujar-milk-shop-backend",
  "version": "1.0.0",
  "description": "Backend API for Gujar Milk Shop",
  "main": "dist/bootstrap.js",
  "bin": "dist/bootstrap.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "start": "node dist/bootstrap.js",
    "start:cloud": "node dist/cloud/cloudServer.js",
    "dev:cloud": "ts-node-dev --respawn --transpile-only src/cloud/cloudServer.ts",
    "dev": "ts-node-dev --respawn --transpile-only src/bootstrap.ts",
    "build": "tsc",
    "build:sidecar": "node scripts/build-sidecar.js",
    "sync:audit": "node scripts/neon-retention-manager.js --dry-run",
    "test:walk-in-migration": "ts-node scripts/test-walk-in-startup-migration.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/pg": "^8.23.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.11",
    "cpx": "^1.5.0",
    "pkg": "^5.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "pkg": {
    "assets": [
      "node_modules/.prisma/client/**/*",
      "node_modules/@prisma/client/**/*"
    ]
  }
}
