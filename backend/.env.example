PORT=5000
DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="24h"
SUPER_ADMIN_ROLE="super_admin"

# ─── Sync Worker Controls ──────────────────────────────────────────────────
SYNC_WORKER_ENABLED=true
DOWNSTREAM_SYNC_ENABLED=true
SYNC_INTERVAL_MS=10000
SYNC_BATCH_SIZE=50
DOWNSTREAM_SYNC_INTERVAL_MS=15000
DOWNSTREAM_SYNC_BATCH_SIZE=100

# ─── Internal Sync Authentication Secret ──────────────────────────────────
SYNC_INTERNAL_SECRET="your_sync_internal_secret_here"

# ─── Neon PostgreSQL (online cloud mirror) ───────────────────────────────────
NEON_DATABASE_URL="postgresql://neondb_owner:<password>@<host>-pooler.neon.tech/neondb?sslmode=require"